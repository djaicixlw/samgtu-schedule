name = "samgtu-schedule-worker"
main = "cloudflare-worker.js"
compatibility_date = "2024-09-23"

# Cloudflare KV binding for v3 Blind Server architecture
[[kv_namespaces]]
binding = "APP_DATA"
id = "<YOUR_KV_NAMESPACE_ID>"

# Cloudflare D1 (attendance)
[[d1_databases]]
binding = "DB"
database_name = "samgtu-att"
database_id = "<YOUR_D1_DATABASE_ID>"
migrations_dir = "migrations"

# Cloudflare Rate Limiter for staff claim protection
# [[ratelimits]]
# name = "CLAIM_LIMITER"
# namespace_id = "1001"
# simple = { limit = 10, period = 60 }
